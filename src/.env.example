# Healthcare Application Environment Variables
# Copy this file to .env and update with your actual values

# Application
ENVIRONMENT=dev
AWS_REGION=ap-south-1

# Database (these will be injected from AWS Secrets Manager in production)
DATABASE_URL=postgresql://healthcareapp:password@localhost:5432/healthcaredb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthcaredb
DB_USER=healthcareapp
DB_PASSWORD=password

# AWS Resources
S3_BUCKET=dev-healthcare-files-123456789012

# Security (for local development only)
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
